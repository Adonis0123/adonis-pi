#!/bin/sh
# pin — launcher and account maintainer for pi (see docs/specs/2026-09-22-adonis-pi-phase1-design.md §3.4).
#   pin [n] [pi args...]   launch account n (default 1; 1 → ~/.pi/agent, n>=2 → ~/.pi-00n/agent)
#   pin setup <n>          materialise templates into the account (never overwrites)
#   pin doctor <n>         check the account; exit 1 on FAIL
#   pin -h                 this help
# Everything that knows the account layout lives in bin/lib/account.ts; this file only does what sh must:
# source proxy.env into the environment and exec pi.
set -eu

PIN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ACCOUNT="$PIN_ROOT/bin/lib/account.ts"

usage() {
  sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
}

need_node() {
  command -v node >/dev/null 2>&1 || { echo "pin: node not found; bin/lib/account.ts needs Node >= 22.18" >&2; exit 1; }
  node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=18)?0:1)' \
    || { echo "pin: Node $(node --version) is too old; >= 22.18 is needed to run bin/lib/account.ts" >&2; exit 1; }
}
account() { node --disable-warning=ExperimentalWarning "$ACCOUNT" "$@"; }

mode_of() { stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1"; }

do_launch() {
  n=$1; shift
  d=$(account dir "$n")
  [ -d "$d" ] || { echo "pin: $d missing; run: pin setup $n" >&2; exit 1; }
  (
    # Provider and MCP-server secrets come only from this account's proxy.env, never from the calling shell.
    # (FIGMA_OAUTH_TOKEN: Framelink prefers it over FIGMA_API_KEY when both are set.)
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL OPENAI_API_KEY OPENAI_BASE_URL FIGMA_API_KEY FIGMA_OAUTH_TOKEN
    if [ -f "$d/proxy.env" ]; then
      m=$(mode_of "$d/proxy.env")
      [ "$m" = "600" ] || { echo "pin: $d/proxy.env must be mode 600 (is $m)" >&2; exit 1; }
      set +u; . "$d/proxy.env"; set -u
    fi
    export PI_CODING_AGENT_DIR="$d"
    if [ "${PIN_DRY_RUN:-0}" = "1" ]; then
      echo "PI_CODING_AGENT_DIR=$d"
      # Names only, never values: every $VAR the account's files reference, every variable proxy.env exports
      # (built-in pi providers such as kimi-coding read their key from the environment), and the cleared inherited ones.
      for v in $(printf '%s\n' $(account vars "$d") ANTHROPIC_API_KEY OPENAI_API_KEY FIGMA_API_KEY FIGMA_OAUTH_TOKEN | awk '!seen[$0]++'); do
        if eval "[ -n \"\${$v:-}\" ]"; then echo "$v=<set>"; else echo "$v=<unset>"; fi
      done
      printf 'ARGS %s\n' "$*"
      exit 0
    fi
    exec pi "$@"
  )
}

cmd=${1:-}
case "$cmd" in
  setup)  shift; need_node; account setup "${1:-1}" "$PIN_ROOT" ;;
  doctor) shift; need_node; account doctor "${1:-1}" "$PIN_ROOT" ;;
  -h|--help) usage ;;
  ""|*[!0-9]*) need_node; do_launch 1 "$@" ;;   # no number: account 1 with everything passed to pi
  *) shift; need_node; do_launch "$cmd" "$@" ;;
esac
