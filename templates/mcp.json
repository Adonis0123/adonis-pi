{
  "autoEnableCodemode": false,
  "mcpServers": {
    "kimi-cu": {
      "command": "{{KIMI_CU_BIN}}",
      "args": [
        "mcp",
        "-s",
        "user"
      ],
      "exposure": "direct"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "exposure": "direct"
    },
    "figma-rest": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp@0.13.2",
        "--stdio",
        "--env",
        "/dev/null",
        "--no-telemetry"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}",
        "FRAMELINK_TELEMETRY": "off"
      },
      "timeout": 180,
      "exposure": "direct"
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    }
  }
}
